{
    "name": "pixelperfectat/magento2-module-amasty-affiliate-attribution-fix",
    "description": "Fixes Amasty Affiliate attribution loss when non-affiliate coupon codes are applied",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-sales-rule": "^101.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "PixelPerfect\\AmastyAffiliateAttributionFix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PixelPerfect\\AmastyAffiliateAttributionFix\\Test\\": "Test/"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "ci:validate": "@composer validate --no-check-publish",
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
